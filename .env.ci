# CI-only environment — no real secrets. Never used outside GitHub Actions.
# Mirrors .env.example but points MONGO_URI at the local `mongodb` CI service
# (docker-compose.ci.yml) instead of a shared/production database.
PORT=5000
NODE_ENV=test

JWT_SECRET=ci-test-jwt-secret-not-for-production-use
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
ADMIN_EMAIL=ci@example.com

ENCRYPTION_KEY=cicicicicicicicicicicicicicicic

SERVER_URL=http://server:5000
MONGO_URI=mongodb://mongodb:27017/enma_trading_ci
MONGO_DB=enma_trading_ci
REDIS_URL=redis://:enma_dev_redis_password@redis:6379
ENGINE_URL=http://engine:8000
ENGINE_API_KEY=ci-test-engine-api-key
INTERNAL_API_KEY=ci-test-internal-api-key
CLIENT_URL=http://localhost:5173

PYTHON_ENV=test
ENGINE_PORT=8000
TIMESCALE_URL=postgresql://enma:enma_dev_password@timescaledb:5432/enma_candles

BINANCE_FETCH_DELAY_MS=200
