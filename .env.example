# ─────────────────────────────────────────
# Server (server/.env)
# Service names (mongodb, redis, engine) are Docker network hostnames.
# Use localhost equivalents only when running outside Docker.
# ─────────────────────────────────────────
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (see workspace/plan/deployment_plan.md Step 2.2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public OAuth callback URL. Optional in dev (defaults to SERVER_URL + path);
# REQUIRED in prod because SERVER_URL stays the internal Docker-network URL.
GOOGLE_CALLBACK_URL=
# Auto-provisioned admin account; cannot be removed via the admin API
ADMIN_EMAIL=

# AES-256 key for Binance credential storage (openssl rand -hex 32)
ENCRYPTION_KEY=

# Internal URL of the Node server, used by the engine for callbacks.
# Docker service name — NOT the public domain (prod uses GOOGLE_CALLBACK_URL above).
SERVER_URL=http://server:5000

# MongoDB — Docker service name
MONGO_URI=mongodb://mongodb:27017/enma_trading

# Redis — Docker service name
REDIS_URL=redis://redis:6379

# Python engine — Docker service name
ENGINE_URL=http://engine:8000
ENGINE_API_KEY=change_this_to_a_random_string

# Shared secret authenticating engine -> Node /internal/* callbacks (distinct
# from ENGINE_API_KEY, which authenticates the other direction). Plan 3 Step 3.1.
INTERNAL_API_KEY=change_this_to_a_different_random_string

# Client origin (for CORS)
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────
# Engine (engine/.env)
# ─────────────────────────────────────────
PYTHON_ENV=development
ENGINE_PORT=8000
ENGINE_API_KEY=change_this_to_a_random_string

# MongoDB — Docker service name
MONGO_URI=mongodb://mongodb:27017/enma_trading
MONGO_DB=enma_trading

# TimescaleDB — Docker service name
# Format: postgresql://user:password@host:port/dbname
TIMESCALE_URL=postgresql://enma:password@timescaledb:5432/enma_candles

# Redis — Docker service name
REDIS_URL=redis://redis:6379

# NOTE: no BINANCE_API_KEY/BINANCE_SECRET here — the engine never reads Binance
# credentials from env. Every user's Binance testnet/mainnet key pair lives
# exclusively in their own encrypted Settings record (per-user directive,
# Plan 4 Step 4.1/4.2 inventory) and is injected per-request from there.

# ─────────────────────────────────────────
# Client (client/.env)
# Always points to localhost — browser talks to the host, not Docker hostnames
# ─────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
