# ─────────────────────────────────────────
# Server (server/.env)
# Service names (mongodb, redis, engine) are Docker network hostnames.
# Use localhost equivalents only when running outside Docker.
# ─────────────────────────────────────────
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MongoDB — Docker service name
MONGO_URI=mongodb://mongodb:27017/enma_trading

# Redis — Docker service name
REDIS_URL=redis://redis:6379

# Python engine — Docker service name
ENGINE_URL=http://engine:8000
ENGINE_API_KEY=change_this_to_a_random_string

# Client origin (for CORS)
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────
# Engine (engine/.env)
# ─────────────────────────────────────────
PYTHON_ENV=development
ENGINE_PORT=8000
ENGINE_API_KEY=change_this_to_a_random_string

# MongoDB — Docker service name
MONGO_URI=mongodb://mongodb:27017/enma_trading
MONGO_DB=enma_trading

# TimescaleDB — Docker service name
# Format: postgresql://user:password@host:port/dbname
TIMESCALE_URL=postgresql://enma:password@timescaledb:5432/enma_candles

# Redis — Docker service name
REDIS_URL=redis://redis:6379

# Binance (leave blank until ready to connect)
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true

# ─────────────────────────────────────────
# Client (client/.env)
# Always points to localhost — browser talks to the host, not Docker hostnames
# ─────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
