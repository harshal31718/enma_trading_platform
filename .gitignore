.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# Claude Code / spec files (local only — NOT workspace/, which IS tracked in git)
.claude/
.mcp.json
CLAUDE.md
AGENTS.md
client/CLAUDE.md
server/CLAUDE.md
engine/CLAUDE.md
