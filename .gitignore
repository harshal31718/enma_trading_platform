# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/
env/

# Environment files - NEVER commit these
.env

# SSH keypairs (Oracle instance access, etc.) — never commit
/keys
.env.local
.env.production
# Exception: client prod env holds only public build-time URLs (no secrets)
# and must be tracked so VPS builds bake in the right domain
!client/.env.production

